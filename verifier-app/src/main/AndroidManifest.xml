<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app find the browser's Custom Tabs service on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="SMART Check-in Verifier"
        android:theme="@style/Theme.SmartCheckin">
        <activity
            android:name=".VerifierActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <!-- Handles these itself (Compose redraws), so a check-in in progress and its
                 result survive turning the phone or switching dark mode. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Carries the Custom Tabs message channel (androidx.browser). -->
        <service
            android:name="androidx.browser.customtabs.PostMessageService"
            android:exported="true" />
    </application>
</manifest>
